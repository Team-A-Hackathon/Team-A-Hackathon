      ],
      "source": [
        "CATEGORICAL = [\"age_group\", \"education\", \"race\", \"sex\", \"income_poverty\", \"marital_status\",\n",
        "               \"rent_or_own\", \"employment_status\", \"census_msa\", \"employment_sector\"]\n",
        "BEHAVIOURS = [c for c in df_train if c.startswith(\"behavioral_\")]\n",
        "\n",
        "\n",
        "def build_features(frame):\n",
        "    out = frame.drop(columns=[KEY, TARGET], errors=\"ignore\").copy()\n",
        "    out[\"precautions\"] = out[BEHAVIOURS].sum(axis=1, min_count=1)\n",
        "    out[\"doctor_and_belief\"] = out[\"doctor_recc_seasonal\"] * out[\"opinion_seas_vacc_effective\"]\n",
        "    for c in CATEGORICAL:\n",
        "        out[c] = out[c].astype(\"object\")\n",
        "    return out\n",
        "\n",
        "\n",
        "X = build_features(df_train)\n",
        "X_test = build_features(df_test)\n",
        "NUMERIC = [c for c in X if c not in CATEGORICAL]\n",
        "\n",
        "encode_L = ColumnTransformer([\n",
        "    (\"num\", make_pipeline(SimpleImputer(strategy=\"median\", add_indicator=True), StandardScaler()), NUMERIC),\n",
        "    (\"cat\", make_pipeline(SimpleImputer(strategy=\"constant\", fill_value=\"missing\"),\n",
        "                          OneHotEncoder(handle_unknown=\"ignore\", min_frequency=20)), CATEGORICAL)])\n",
        "\n",
        "encode_T = ColumnTransformer([\n",
        "    (\"cat\", OrdinalEncoder(handle_unknown=\"use_encoded_value\", unknown_value=-1, encoded_missing_value=-1), CATEGORICAL),\n",
        "    (\"num\", \"passthrough\", NUMERIC)])\n",
        "encode_T_filled = ColumnTransformer([\n",
        "    (\"cat\", OrdinalEncoder(handle_unknown=\"use_encoded_value\", unknown_value=-1, encoded_missing_value=-1), CATEGORICAL),\n",
        "    (\"num\", SimpleImputer(strategy=\"constant\", fill_value=-1), NUMERIC)])\n",
        "IS_CAT = [True] * len(CATEGORICAL) + [False] * len(NUMERIC)\n",
        "print(f\"{X.shape[1]} columns in: {len(NUMERIC)} numeric, {len(CATEGORICAL)} categorical\")"
      ]
    },

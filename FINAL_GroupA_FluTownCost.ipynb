        "    ax.axvline(y.mean(), color=\"black\", lw=0.8, ls=\"--\")\n",
        "    for i, (rate, n) in enumerate(zip(tab[\"rate\"], tab[\"n\"])):\n",
        "        ax.text(rate + 0.01, i, f\"n={n}\", va=\"center\", fontsize=7, color=\"dimgrey\")\n",
        "    ax.set(xlim=(0, 1.1), title=col, xlabel=\"uptake\")\n",

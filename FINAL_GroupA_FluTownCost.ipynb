      "source": [
        "FOLDS = RepeatedStratifiedKFold(n_splits=10, n_repeats=2, random_state=RANDOM_STATE)\n",
        "results, oof_q = {}, {}\n",
        "\n",
        "\n",
        "def score_model(name, estimator, store=True):\n",
        "    # store=False is used for pre-processing experiments, which should not enter the submission league table\n",
        "    per_fold, q_sum, q_n = [], np.zeros(N), np.zeros(N)\n",
        "    for train_idx, valid_idx in FOLDS.split(X, y):\n",
        "        fitted = clone(estimator).fit(X.iloc[train_idx], y[train_idx])\n",
        "        q = fitted.predict_proba(X.iloc[valid_idx])[:, 1]\n",
        "        ru, rv, yv = r_u_train[valid_idx], r_v_train[valid_idx], y[valid_idx]\n",
        "        per_fold.append({\n",
        "            \"bill\": town_bill(yv, post_vaccine(q, ru, rv), ru, rv) / len(valid_idx),\n",
        "            \"bill_at_half\": town_bill(yv, q >= 0.5, ru, rv) / len(valid_idx),\n",
        "            \"auc\": roc_auc_score(yv, q), \"brier\": brier_score_loss(yv, q)})\n",
        "        q_sum[valid_idx] += q; q_n[valid_idx] += 1\n",
        "    r = pd.DataFrame(per_fold)\n",
        "    if store:\n",
        "        results[name], oof_q[name] = r, q_sum / q_n\n",
        "    print(f\"{name:<26} ${r.bill.mean():7.2f} ± {r.bill.std():5.2f} per resident   AUC {r.auc.mean():.3f}   Brier {r.brier.mean():.4f}\")\n",
        "    return r\n",
        "\n",
        "\n",
        "candidates = {\n",
        "    \"Logistic (L2)\": make_pipeline(encode_L, LogisticRegression(C=0.2, max_iter=5000)),\n",
        "    \"Neural net (MLP)\": make_pipeline(encode_L, MLPClassifier(hidden_layer_sizes=(32, 16), alpha=1e-2, learning_rate_init=1e-3,\n",
        "                                       early_stopping=True, max_iter=500, random_state=RANDOM_STATE)),\n",
        "    \"Extra trees\": make_pipeline(encode_T_filled, ExtraTreesClassifier(n_estimators=500, min_samples_leaf=8, max_features=0.4,\n",
        "                                  n_jobs=-1, random_state=RANDOM_STATE)),\n",
        "    \"LightGBM\": make_pipeline(encode_T, LGBMClassifier(n_estimators=350, learning_rate=0.03, num_leaves=12, min_child_samples=40,\n",
        "                               subsample=0.85, subsample_freq=1, colsample_bytree=0.7, reg_lambda=2.0,\n",
        "                               random_state=RANDOM_STATE, verbose=-1)),\n",
        "}\n",
        "for name, est in candidates.items():\n",
        "    _ = score_model(name, est)"
      ]
    },

      "source": [
        "BINARY = [c for c in df_train if c.startswith(\"behavioral_\")] + [\"doctor_recc_seasonal\", \"child_under_6_months\",\n",
        "                                                                  \"health_worker\", \"health_insurance\"]\n",
        "SHEET_RANGE = {\"flu_concern\": (0, 3), \"flu_knowledge\": (0, 2), \"opinion_seas_vacc_effective\": (1, 5),\n",
        "               \"opinion_seas_risk\": (1, 5), \"opinion_seas_sick_from_vacc\": (1, 5), \"household_adults\": (0, 3),\n",
        "               \"household_children\": (0, 3), \"number_chronic_med_conditions\": (0, 8), **{c: (0, 1) for c in BINARY}}\n",
        "\n",
        "rows = []\n",
        "for col in df_test.columns.drop(KEY):\n",
        "    both = pd.concat([df_train[col], df_test[col]])\n",
        "    numeric = pd.api.types.is_numeric_dtype(both)\n",
        "    lo, hi = SHEET_RANGE.get(col, (None, None))\n",
        "    rows.append({\"column\": col, \"type\": \"numeric\" if numeric else \"text\", \"levels\": both.nunique(),\n",
        "                 \"% missing train\": round(df_train[col].isna().mean() * 100, 1),\n",
        "                 \"% missing test\": round(df_test[col].isna().mean() * 100, 1),\n",
        "                 \"min\": both.min() if numeric else \"\", \"max\": both.max() if numeric else \"\",\n",
        "                 \"sheet range\": f\"{lo}-{hi}\" if lo is not None else \"categories\",\n",
        "                 \"within sheet range\": bool(both.dropna().between(lo, hi).all()) if lo is not None else True})\n",
        "audit = pd.DataFrame(rows).set_index(\"column\")\n",
        "\n",
        "assert audit[\"within sheet range\"].all(), audit[~audit[\"within sheet range\"]]\n",
        "assert not df_train[KEY].duplicated().any() and not df_test[KEY].duplicated().any()\n",
        "assert not set(df_train[KEY]) & set(df_test[KEY]), \"a respondent appears in both files\"\n",
        "assert set(df_train[TARGET].unique()) == {0, 1}\n",
        "print(f\"all values within the ranges on the dataset sheet | duplicate ids: 0 | train/test overlap: 0 | \"\n",
        "      f\"fully duplicated training rows: {df_train.drop(columns=KEY).duplicated().sum()}\")\n",
        "audit"
      ]
    },

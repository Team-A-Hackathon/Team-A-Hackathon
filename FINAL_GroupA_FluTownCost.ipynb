        "from sklearn.model_selection import cross_val_score\n",
        "both = pd.concat([df_train.drop(columns=[KEY, TARGET]), df_test.drop(columns=KEY)], ignore_index=True)\n",
        "for c in both.select_dtypes(\"object\"):\n",
        "    both[c] = both[c].astype(\"category\")\n",
        "is_test = np.r_[np.zeros(len(df_train)), np.ones(len(df_test))]\n",
        "adv_auc = cross_val_score(LGBMClassifier(n_estimators=200, learning_rate=0.05, num_leaves=15, verbose=-1, random_state=RANDOM_STATE),\n",
        "                          both, is_test, cv=StratifiedKFold(5, shuffle=True, random_state=RANDOM_STATE), scoring=\"roc_auc\")\n",
        "print(f\"train-vs-test AUC: {adv_auc.mean():.3f} ± {adv_auc.std():.3f}\")\n",
        "\n",
        "shift = {}\n",
        "for c in both.columns:\n",
        "    a = df_train[c].astype(\"string\").fillna(\"missing\").value_counts(normalize=True)\n",
        "    b = df_test[c].astype(\"string\").fillna(\"missing\").value_counts(normalize=True)\n",
        "    shift[c] = 0.5 * a.sub(b, fill_value=0).abs().sum()      # total variation distance, 0 = identical\n",
        "shift = pd.Series(shift).sort_values(ascending=False)\n",
        "shift.head(10).sort_values().plot(kind=\"barh\", figsize=(7, 4), color=PALETTE[\"neutral\"])\n",
        "plt.xlabel(\"difference in distribution, train vs test (0 = identical, 1 = no overlap)\")\n",
        "plt.title(\"Largest train/test differences\"); plt.show()\n",
        "print(f\"largest difference: {shift.index[0]} ({shift.iloc[0]:.3f})\")"
      ]
    },

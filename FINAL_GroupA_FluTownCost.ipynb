        "\n",
        "def encoder_L(numeric, categorical, flags=True, num_strategy=\"median\"):\n",
        "    return ColumnTransformer([\n",
        "        (\"num\", make_pipeline(SimpleImputer(strategy=num_strategy, add_indicator=flags), StandardScaler()), numeric),\n",
        "        (\"cat\", make_pipeline(SimpleImputer(strategy=\"constant\", fill_value=\"missing\") if flags else SimpleImputer(strategy=\"most_frequent\"),\n",
        "                              OneHotEncoder(handle_unknown=\"ignore\", min_frequency=20)), categorical)])\n",
        "\n",
        "\n",
        "logit = LogisticRegression(C=0.2, max_iter=5000)\n",
        "lgbm = candidates[\"LightGBM\"].steps[-1][1]\n",
        "prep_options = {\n",
        "    \"L-base\": make_pipeline(encoder_L(NUMERIC, CATEGORICAL), logit),\n",
        "    \"L-no-flags\": make_pipeline(encoder_L(NUMERIC, CATEGORICAL, flags=False, num_strategy=\"most_frequent\"), logit),\n",
        "    # opinions as categories: missing answers become level 0, then every level (0-5) gets its own indicator column\n",
        "    \"L-opinions-binned\": make_pipeline(ColumnTransformer(\n",
        "        encoder_L([c for c in NUMERIC if c not in OPINIONS], CATEGORICAL).transformers\n",
        "        + [(\"opinion\", make_pipeline(SimpleImputer(strategy=\"constant\", fill_value=0),\n",
        "                                     OneHotEncoder(handle_unknown=\"ignore\")), OPINIONS)]), logit),\n",
        "    \"L-no-engineered\": make_pipeline(encoder_L([c for c in NUMERIC if c not in ENGINEERED], CATEGORICAL), logit),\n",
        "    \"T-native-NaN\": make_pipeline(encode_T, lgbm),\n",
        "    \"T-filled\": make_pipeline(encode_T_filled, lgbm),\n",
        "}\n",
        "prep_runs = {name: score_model(name, est, store=False) for name, est in prep_options.items()}\n",
        "\n",
        "baseline_of = {n: (\"L-base\" if n.startswith(\"L\") else \"T-native-NaN\") for n in prep_runs}\n",
        "prep_table = pd.DataFrame({\n",
        "    n: {\"$ per resident\": r.bill.mean(), \"paired diff vs baseline\": (r.bill - prep_runs[baseline_of[n]].bill).mean(),\n",
        "        \"sd of paired diff\": (r.bill - prep_runs[baseline_of[n]].bill).std(),\n",
        "        \"folds cheaper than baseline\": int(((r.bill - prep_runs[baseline_of[n]].bill) < 0).sum()),\n",
        "        \"AUC\": r.auc.mean(), \"Brier\": r.brier.mean()} for n, r in prep_runs.items()}).T\n",
        "for n, r in prep_table.drop(index=[\"L-base\", \"T-native-NaN\"]).iterrows():\n",
        "    verdict = \"helps\" if r[\"folds cheaper than baseline\"] >= 15 else (\"hurts\" if r[\"folds cheaper than baseline\"] <= 5 else \"makes no clear difference\")\n",
        "    print(f\"{n:<18} {verdict:<26} (cheaper in {int(r['folds cheaper than baseline'])}/20 folds, mean {r['paired diff vs baseline']:+.2f} $)\")\n",
        "prep_table.style.format({\"AUC\": \"{:.3f}\", \"Brier\": \"{:.4f}\", \"folds cheaper than baseline\": \"{:.0f}\"}, precision=2)"
      ]
    },

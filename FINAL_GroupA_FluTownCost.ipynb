      "outputs": [],
      "source": [
        "COST_VACCINE = 300.0          # given on the Dataset A sheet\n",
        "COST_HOSPITAL = 18_500.0      # given on the Dataset A sheet\n",
        "\n",
        "# ---- assumptions: averaged generative-AI answers (table in A.4) ----\n",
        "RISK_TABLE = pd.DataFrame({\n",
        "    \"age_group\": [\"18 - 34 Years\", \"35 - 44 Years\", \"45 - 54 Years\", \"55 - 64 Years\", \"65+ Years\"],\n",
        "    \"risk_unvaccinated\": [0.00097, 0.00143, 0.0026, 0.00483, 0.01833],   # mean of the three AI answers in A.4\n",
        "}).set_index(\"age_group\")[\"risk_unvaccinated\"]\n",
        "VACCINE_EFFECT = 0.383        # share of hospitalisations prevented by the jab (mean of 0.40, 0.40, 0.35)\n",
        "CHRONIC_FACTOR = 2.0          # risk multiplier for each chronic condition, compounding (all three AIs said 2.0)\n",
        "\n",
        "\n",
        "def resident_risk(frame, table=RISK_TABLE, effect=VACCINE_EFFECT, chronic_factor=CHRONIC_FACTOR):\n",
        "    # hospitalisation probability of each resident without (r_u) and with (r_v) the vaccine\n",
        "    base = frame[\"age_group\"].map(table).fillna(table.mean()).to_numpy(float)\n",
        "    n_chronic = frame[\"number_chronic_med_conditions\"].fillna(0).to_numpy(float)\n",
        "    r_u = np.minimum(base * chronic_factor ** n_chronic, 1.0)\n",
        "    return r_u, r_u * (1 - effect)\n",
        "\n",
        "\n",
        "def town_bill(takes, posted, r_u, r_v, V=COST_VACCINE, H=COST_HOSPITAL):\n",
        "    # total dollars the town spends; lower is better\n",
        "    takes = np.asarray(takes, dtype=bool)\n",
        "    posted = np.asarray(posted, dtype=bool)\n",
        "    vaccines = V * (posted | takes)                     # posted dose, or cash for a resident who wanted one\n",
        "    protected = posted & takes                          # only a posted AND accepted dose lowers risk\n",
        "    hospital = H * np.where(protected, r_v, r_u)\n",
        "    return float((vaccines + hospital).sum())\n",
        "\n",
        "\n",
        "def cutoff(r_u, r_v, V=COST_VACCINE, H=COST_HOSPITAL):\n",
        "    return V / (V + (r_u - r_v) * H)\n",
        "\n",
        "\n",
        "def post_vaccine(q, r_u, r_v, V=COST_VACCINE, H=COST_HOSPITAL):\n",
        "    return np.asarray(q) > cutoff(r_u, r_v, V, H)"
      ]
    },

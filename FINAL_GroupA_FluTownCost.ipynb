        "panels = [\"doctor_recc_seasonal\", \"opinion_seas_vacc_effective\", \"opinion_seas_risk\", \"opinion_seas_sick_from_vacc\",\n",
        "          \"age_group\", \"number_chronic_med_conditions\", \"health_insurance\", \"race\"]\n",
        "fig, axes = plt.subplots(2, 4, figsize=(18, 7.5))\n",
        "for ax, col in zip(axes.ravel(), panels):\n",

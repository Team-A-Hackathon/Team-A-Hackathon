      "outputs": [],
      "source": [
        "from sklearn.metrics import confusion_matrix, accuracy_score, precision_score, recall_score\n",
        "q_lead = oof_q[leader]\n",
        "decisions = {\"personal cut-off\": post_vaccine(q_lead, r_u_train, r_v_train), \"0.5 cut-off\": q_lead >= 0.5}\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(11, 4.2))\n",
        "summary_rows = []\n",
        "for ax, (rule, posted) in zip(axes, decisions.items()):\n",
        "    cm = confusion_matrix(y, posted, labels=[0, 1])\n",
        "    cell_cost = np.zeros((2, 2))\n",
        "    for t in (0, 1):\n",
        "        for p in (0, 1):\n",
        "            m = (y == t) & (posted == p)\n",
        "            cell_cost[t, p] = town_bill(y[m], posted[m], r_u_train[m], r_v_train[m])\n",
        "    labels = np.array([[f\"{cm[t, p]:,}\\n${cell_cost[t, p] / 1e3:,.0f}k\" for p in (0, 1)] for t in (0, 1)])\n",
        "    sns.heatmap(cm, annot=labels, fmt=\"\", cmap=\"Purples\", cbar=False, ax=ax,\n",
        "                xticklabels=[\"not posted\", \"posted\"], yticklabels=[\"refused\", \"took it\"])\n",
        "    ax.set(title=f\"{rule}: town bill ${cell_cost.sum() / 1e6:,.3f}m\", xlabel=\"our decision\", ylabel=\"what the resident did\")\n",
        "    summary_rows.append({\"rule\": rule, \"accuracy\": accuracy_score(y, posted), \"precision\": precision_score(y, posted),\n",
        "                         \"recall\": recall_score(y, posted), \"share posted\": posted.mean(), \"$ per resident\": cell_cost.sum() / N})\n",
        "plt.suptitle(f\"{leader}, out-of-fold (each cell: residents and their total cost)\", y=1.03); plt.tight_layout(); plt.show()\n",
        "pd.DataFrame(summary_rows).set_index(\"rule\").round(3)"
      ]

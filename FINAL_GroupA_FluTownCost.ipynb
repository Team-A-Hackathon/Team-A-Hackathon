      "source": [
        "### B.8 Which features are most related to uptake?\n",
        "One number per feature so that all 29 can be compared: **Cramér's V** between the feature (each value, including \"missing\", treated as a category) and the target. 0 means no relation, 1 a perfect one. It works the same for text, ordinal and binary columns, and it catches non-linear patterns that a correlation would miss."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 17,
      "id": "a8cca7f8",
      "metadata": {
        "execution": {
          "iopub.execute_input": "2026-11-11T11:53:25.695283Z",
          "iopub.status.busy": "2026-11-11T11:53:25.695208Z",
          "iopub.status.idle": "2026-11-11T11:53:25.820339Z",
          "shell.execute_reply": "2026-11-11T11:53:25.819975Z"
        },
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 933
        },
        "id": "a8cca7f8",
        "outputId": "b58ab21b-e50f-459b-c365-10e8f9b3a31c"
      },
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 880x990 with 1 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        },
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "strongest five: opinion_seas_risk (0.40), opinion_seas_vacc_effective (0.39), doctor_recc_seasonal (0.35), age_group (0.28), employment_sector (0.22)\n",
            "weakest five:   behavioral_antiviral_meds (0.02), census_msa (0.03), behavioral_face_mask (0.04), behavioral_outside_home (0.05), behavioral_large_gatherings (0.05)\n"
          ]
        }
      ],
      "source": [
        "from scipy.stats import chi2_contingency\n",
        "\n",
        "\n",
        "def cramers_v(feature, target):\n",
        "    table = pd.crosstab(feature.astype(\"string\").fillna(\"missing\"), target)\n",
        "    chi2 = chi2_contingency(table, correction=False)[0]\n",
        "    return np.sqrt(chi2 / (table.to_numpy().sum() * (min(table.shape) - 1)))\n",
        "\n",
        "\n",
        "GROUPS = {\"opinion / attitude\": [\"flu_concern\", \"flu_knowledge\"] + [c for c in df_train if c.startswith(\"opinion_\")],\n",
        "          \"health and care\": [\"doctor_recc_seasonal\", \"health_insurance\", \"health_worker\", \"child_under_6_months\",\n",
        "                              \"number_chronic_med_conditions\"],\n",
        "          \"behaviour\": [c for c in df_train if c.startswith(\"behavioral_\")]}\n",
        "group_of = {c: g for g, cols in GROUPS.items() for c in cols}\n",
        "assoc = pd.DataFrame({\"cramers_v\": {c: cramers_v(df_train[c], df_train[TARGET]) for c in df_test.columns.drop(KEY)}})\n",
        "assoc[\"group\"] = [group_of.get(c, \"demographic\") for c in assoc.index]\n",
        "assoc = assoc.sort_values(\"cramers_v\")\n",
        "\n",
        "colours = {\"opinion / attitude\": PALETTE[\"take\"], \"health and care\": PALETTE[\"neutral\"],\n",
        "           \"behaviour\": PALETTE[\"grey\"], \"demographic\": PALETTE[\"refuse\"]}\n",
        "fig, ax = plt.subplots(figsize=(8, 9))\n",
        "ax.barh(assoc.index, assoc[\"cramers_v\"], color=assoc[\"group\"].map(colours))\n",
        "for g, c in colours.items():\n",
        "    ax.barh([], [], color=c, label=g)\n",
        "ax.set(xlabel=\"Cramér's V with seasonal_vaccine\", title=\"Strength of association with uptake, all features\")\n",
        "ax.legend(frameon=False, loc=\"lower right\"); plt.show()\n",
        "print(\"strongest five:\", \", \".join(f\"{c} ({v:.2f})\" for c, v in assoc[\"cramers_v\"].sort_values(ascending=False).head(5).items()))\n",
        "print(\"weakest five:  \", \", \".join(f\"{c} ({v:.2f})\" for c, v in assoc[\"cramers_v\"].sort_values().head(5).items()))"
      ]
    },
